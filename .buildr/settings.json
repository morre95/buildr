{
  "model": {
    "defaultProvider": "ollama",
    "defaultModel": "qwen2.5-coder",
    "baseUrls": {
      "ollama": "http://127.0.0.1:11434",
      "lmstudio-openai": "http://127.0.0.1:1234"
    },
    "credentialRefs": {}
  },
  "context": {
    "maxTokens": 32000,
    "respectGitignore": true,
    "redactSecrets": true
  },
  "embeddings": {
    "provider": "local-transformers",
    "localModel": "Xenova/all-MiniLM-L6-v2",
    "ollamaModel": "nomic-embed-text",
    "lmStudioModel": "text-embedding-nomic-embed-text-v1.5"
  },
  "agent": {
    "maxIterationsPerStep": 5,
    "maxToolCallsPerTask": 50,
    "requirePlanForWrites": true
  },
  "rules": {
    "enabled": true,
    "rulePacks": ["agent-behavior", "verification", "git-workflow"],
    "failOnLinterWarnings": true,
    "allowUnverifiedCompletion": "ask",
    "commonMistakes": true,
    "agentDocs": true
  },
  "telemetry": {
    "enabled": false,
    "includePrompts": false,
    "includeFilePaths": false
  },
  "privacy": {
    "cloudSendPolicy": "ask"
  }
}
