{
  "name": "buildr-vscode",
  "displayName": "Buildr",
  "description": "Local-model-first agentic coding workflows for VS Code.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "publisher": "buildr",
  "categories": ["AI", "Other"],
  "main": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "extensionKind": ["workspace", "ui"],
  "engines": {
    "vscode": "^1.96.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Buildr runs in read-only Plan Mode until the workspace is trusted."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "buildr.plan",
        "title": "Buildr: Plan"
      },
      {
        "command": "buildr.runApprovedPlan",
        "title": "Buildr: Run Approved Plan"
      },
      {
        "command": "buildr.configureModel",
        "title": "Buildr: Configure Model"
      },
      {
        "command": "buildr.openSettings",
        "title": "Buildr: Open Settings"
      },
      {
        "command": "buildr.stop",
        "title": "Buildr: Stop"
      },
      {
        "command": "buildr.indexWorkspace",
        "title": "Buildr: Index Workspace"
      },
      {
        "command": "buildr.mcpList",
        "title": "Buildr: MCP List"
      },
      {
        "command": "buildr.doctor",
        "title": "Buildr: Doctor"
      },
      {
        "command": "buildr.debug",
        "title": "Buildr: Debug"
      }
    ],
    "chatParticipants": [
      {
        "id": "buildr.chat",
        "name": "buildr",
        "description": "Plan Buildr coding tasks from VS Code Chat."
      }
    ],
    "languageModelTools": [
      {
        "name": "buildr_workspaceContext",
        "tags": ["buildr", "workspace"],
        "toolReferenceName": "workspaceContext",
        "displayName": "Buildr Workspace Context",
        "modelDescription": "Find relevant files and summaries from the current workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Task or topic to search for."
            }
          },
          "required": ["query"]
        }
      }
    ],
    "configuration": {
      "title": "Buildr",
      "properties": {
        "buildr.model.provider": {
          "type": "string",
          "default": "ollama",
          "enum": ["ollama", "lmstudio-openai", "lmstudio-native", "openai-compatible"],
          "description": "Default model provider used by Buildr."
        },
        "buildr.model.ollamaBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama endpoint reachable from the active extension host."
        },
        "buildr.model.lmStudioBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:1234",
          "description": "LM Studio endpoint reachable from the active extension host."
        },
        "buildr.context.tokenBudget": {
          "type": "number",
          "default": 32000,
          "minimum": 1000,
          "description": "Maximum context token budget Buildr should target."
        },
        "buildr.permissions.defaultWritePolicy": {
          "type": "string",
          "default": "require_approval",
          "enum": ["context_review", "require_approval", "always_confirm", "always_deny"],
          "description": "Default policy for tools that can modify files or run commands."
        },
        "buildr.privacy.cloudSendPolicy": {
          "type": "string",
          "default": "ask",
          "enum": ["never", "ask", "allow"],
          "description": "Controls whether Buildr may send workspace context to non-local providers."
        },
        "buildr.rules.rulePacks": {
          "type": "array",
          "default": ["agent-behavior", "verification", "git-workflow"],
          "items": {
            "type": "string"
          },
          "description": "Rule packs Buildr applies before completion."
        },
        "buildr.verification.level": {
          "type": "string",
          "default": "standard",
          "enum": ["light", "standard", "strict"],
          "description": "Verification strictness for completion gates and warnings."
        },
        "buildr.embeddings.provider": {
          "type": "string",
          "default": "local-transformers",
          "enum": ["local-transformers", "ollama", "lmstudio-openai", "disabled"],
          "description": "Embedding provider for semantic context ranking."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc -b --pretty false",
    "package": "XDG_CACHE_HOME=../../.pnpm-cache pnpm dlx @vscode/vsce package"
  },
  "dependencies": {
    "@buildr/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.3"
  }
}
